# SecOp Audit - Configuration

# Debug mode
DEBUG=false

# Logging
LOG_LEVEL=INFO

# Database
DATABASE__PATH=data/secop.db

# Security
SECURITY__SESSION_TIMEOUT_MINUTES=30
SECURITY__MAX_LOGIN_ATTEMPTS=5
SECURITY__LOCKOUT_DURATION_MINUTES=15

# UI
UI__THEME=darkly

# Scanners
SCANNER__NMAP_PATH=
SCANNER__OPENVAS_HOST=localhost
SCANNER__OPENVAS_PORT=9390
SCANNER__OPENVAS_USERNAME=admin
SCANNER__OPENVAS_PASSWORD=
SCANNER__NUCLEI_PATH=

# LDAP / Active Directory
LDAP__SERVER=
LDAP__PORT=389
LDAP__USE_SSL=false
LDAP__SSL_PORT=636
LDAP__BASE_DN=
LDAP__BIND_DN=
LDAP__BIND_PASSWORD=

# Google Workspace
GOOGLE_WORKSPACE__CREDENTIALS_FILE=
GOOGLE_WORKSPACE__ADMIN_EMAIL=
