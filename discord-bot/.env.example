# Token du bot Discord (Settings > Bot > Reset Token)
DISCORD_BOT_TOKEN=your_bot_token_here

# Secret partagé avec GitLab (optionnel mais recommandé)
GITLAB_WEBHOOK_SECRET=your_secret_here

# Token GitLab pour /deploy et /status (Settings > Access Tokens)
GITLAB_TOKEN=your_gitlab_token_here

# ID du projet GitLab (visible dans Settings > General)
GITLAB_PROJECT_ID=your_project_id

# IDs des salons Discord (clic droit sur le salon > Copier l'identifiant)
DISCORD_CHANNEL_CI_ID=channel_id_for_ci_notifications
DISCORD_CHANNEL_GIT_ID=channel_id_for_git_notifications

# Port du serveur webhook (doit être accessible depuis GitLab)
WEBHOOK_PORT=8001
