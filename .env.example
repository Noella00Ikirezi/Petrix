# ============================================================
# Petrix — Variables d'environnement
# Copier en .env et remplir les valeurs réelles
# NE JAMAIS committer .env (il est dans .gitignore)
# ============================================================

# --- Base de données PostgreSQL ---
POSTGRES_USER=petrix
POSTGRES_PASSWORD=changeme
POSTGRES_DB=petrix
# Dev (docker-compose.yml) :  postgresql://petrix:changeme@db:5432/petrix
# Prod AWS EC2 :               postgresql://petrix:changeme@db:5432/petrix
DATABASE_URL=postgresql://petrix:changeme@db:5432/petrix

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Sécurité ---
# Générer avec : openssl rand -hex 32
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Dev : http://localhost:5173
# Prod : https://petrix.noellahome.org
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Mode ---
DEBUG=false

# --- Compte admin (créé au premier démarrage) ---
ADMIN_PASSWORD=changeme

# --- Email / SMTP ---
# Dev : Mailpit (port 1025, SMTP_TLS=false) — visible sur http://localhost:8025
# Prod : configurer AWS SES ou autre provider SMTP
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@petrix.local
SMTP_FROM_NAME=Petrix
SMTP_TLS=false

# --- MFA ---
MFA_ENABLED=true

# --- Tests (docker-compose.test.yml) ---
TEST_POSTGRES_PASSWORD=changeme
TEST_ADMIN_PASSWORD=changeme
TEST_SECRET_KEY=changeme
