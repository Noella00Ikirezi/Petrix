# ============================================================
# Petrix — Variables d'environnement
# Copier en .env et remplir les valeurs réelles
# NE JAMAIS committer .env (il est dans .gitignore)
# ============================================================

# --- Base de données PostgreSQL ---
POSTGRES_USER=petrix
POSTGRES_PASSWORD=changeme
POSTGRES_DB=petrix
# Dev local (docker-compose.yml) :
# DATABASE_URL=postgresql://petrix:changeme@db:5432/petrix
# Prod AWS RDS :
# DATABASE_URL=postgresql://petrix:changeme@<rds-endpoint>:5432/petrix
DATABASE_URL=postgresql://petrix:changeme@localhost:5432/petrix

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Sécurité ---
SECRET_KEY=changeme-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Dev : http://localhost:5173
# Prod : https://petrix.noellahome.org,http://<ec2-ip>
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Mode ---
DEBUG=false

# --- Admin ---
ADMIN_PASSWORD=changeme

# --- Email / SMTP ---
# Dev : utilise Mailpit (SMTP_PORT=1025, SMTP_TLS=false)
# Prod : configurer avec Gmail app password ou autre
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@petrix.local
SMTP_FROM_NAME=Petrix
SMTP_TLS=false

# --- AWS S3 (prod) ---
# En prod, utiliser le rôle IAM EC2 — pas besoin de clés ici
AWS_DEFAULT_REGION=eu-west-1
S3_BUCKET=changeme-bucket-name
# MINIO_ENDPOINT=s3.eu-west-1.amazonaws.com  ← prod AWS
# MINIO_ENDPOINT=minio:9000                  ← dev local
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# --- AI / LLM ---
GROQ_API_KEY=
OLLAMA_API_URL=
# OLLAMA_MODEL=llama3.2

# --- Test (docker-compose.test.yml) ---
TEST_POSTGRES_PASSWORD=changeme
TEST_ADMIN_PASSWORD=changeme
TEST_SECRET_KEY=changeme
