# Database
POSTGRES_USER=petrix
POSTGRES_PASSWORD=changeme
POSTGRES_DB=petrix
DATABASE_URL=postgresql://petrix:changeme@localhost:5432/petrix

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Debug
DEBUG=true

# AI (Claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme

# Admin user
ADMIN_PASSWORD=changeme

# Email / SMTP (uses Mailpit in dev)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@petrix.local
SMTP_FROM_NAME=Petrix
SMTP_TLS=false

# Test environment (for docker-compose.test.yml)
TEST_POSTGRES_PASSWORD=changeme
TEST_ADMIN_PASSWORD=changeme
TEST_SECRET_KEY=changeme
